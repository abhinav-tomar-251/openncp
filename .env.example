# ---- Database (Postgres: state + staging + id_xref + pg-boss queue) ----
DATABASE_URL="postgresql://opennpc:opennpc@localhost:5432/opennpc?schema=public"

# ---- App ----
# 32-byte key (base64 or hex) used for AES-256-GCM encryption of Salesforce refresh tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="esY1yWu1vtMmZbw2b98rXYkuODp4I1FNcVIDOtkDKn8="

# api / web ports
API_PORT=3001
# Next.js reads PORT natively (defaults to 3000 if unset)
PORT=3000
# URL the web app uses to reach the api
NEXT_PUBLIC_API_URL="http://localhost:3001"
# URL the api redirects back to after an OAuth connect completes
WEB_APP_URL="http://localhost:3000"

# ---- Salesforce External Client App (ECA) OAuth ----
SF_ECA_CLIENT_ID="CHANGE_ME"
SF_ECA_CLIENT_SECRET="CHANGE_ME"
SF_OAUTH_REDIRECT_URI="http://localhost:3001/oauth/callback"
# Default login host (use https://test.salesforce.com for sandboxes)
SF_LOGIN_URL="https://login.salesforce.com"
# Salesforce REST/Bulk API version used for describe, limits, queries
SF_API_VERSION="62.0"

# ---- Worker tuning (kept within Salesforce API limits) ----
WORKER_CONCURRENCY=4
BULK_BATCH_SIZE=10000
