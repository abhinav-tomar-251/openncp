// OpenNPC Migration Platform — data model.
// Mirrors docs/06-database-schema.md. pg-boss manages its own `pgboss` schema separately.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  source
  target
}

enum Stage {
  analyze
  extract
  transform
  load
  validate
}

enum StageStatus {
  NOT_STARTED
  QUEUED
  RUNNING
  AWAITING_REVIEW
  APPROVED
  DONE
  FAILED
}

enum ObjectStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum LoadStatus {
  pending
  loaded
  error
}

/// An application user. Each user is their own tenant (user-as-tenant): they own
/// their projects and org connections. See docs/17 §B.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  projects MigrationProject[]

  @@map("app_user")
}

/// Server-side session; the cookie stores the session id (a random token).
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Top-level container for one NPSP -> NPC migration.
model MigrationProject {
  id        String   @id @default(uuid())
  name      String
  ownerId   String? // the owning user (tenant). Nullable for pre-auth legacy rows.
  scope     Json     @default("{}") // { core, relationships, programs, campaigns }
  status    String   @default("active") // active | completed | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connections OrgConnection[]
  stageRuns   StageRun[]
  mappings    MappingDefinition[]
  source      StagingSource[]
  target      StagingTarget[]
  idXrefs     IdXref[]
  errors      MigrationError[]
  oauthStates OAuthState[]

  @@index([ownerId])
  @@map("migration_project")
}

/// Transient OAuth flow state (PKCE verifier + role), keyed by the CSRF state token.
/// Rows are deleted on callback; stale rows can be swept by age.
model OAuthState {
  state        String   @id
  projectId    String
  userId       String? // the user who initiated the flow, for audit/ownership checks
  role         OrgRole
  codeVerifier String
  loginUrl     String
  createdAt    DateTime @default(now())

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("oauth_state")
}

/// A connected Salesforce org (one source, one target per project). Tokens encrypted at rest.
model OrgConnection {
  id              String   @id @default(uuid())
  projectId       String
  role            OrgRole
  instanceUrl     String
  orgId           String?
  apiVersion      String?
  accessTokenEnc  Bytes?
  refreshTokenEnc Bytes?
  tokenMeta       Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role])
  @@map("org_connection")
}

/// One row per stage per project (history kept via `attempt`).
model StageRun {
  id         String      @id @default(uuid())
  projectId  String
  stage      Stage
  status     StageStatus @default(NOT_STARTED)
  attempt    Int         @default(1)
  stats      Json        @default("{}")
  /// Analyze only: the org-configuration audit (validation rules, flows, triggers,
  /// TDTM handlers, workflow/duplicate rules, NPSP settings) as { source, target? }.
  /// Nullable — populated by the Analyze job; read by GET /projects/:id/analysis.
  audit      Json?
  error      String?
  approvedBy String?
  approvedAt DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project    MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectRuns ObjectRun[]

  @@index([projectId, stage])
  @@map("stage_run")
}

/// Per-object granularity within a stage — enables isolated re-runs.
model ObjectRun {
  id             String       @id @default(uuid())
  stageRunId     String
  objectApiName  String
  /// Null for Extract/Transform/Load/Validate object runs. Set for Analyze rows to
  /// distinguish source-org discovery from target-org schema-check rows within the
  /// same stage_run.
  role           OrgRole?
  status         ObjectStatus @default(PENDING)
  processedCount Int          @default(0)
  failedCount    Int          @default(0)
  bulkJobId      String?
  checkpoint     Json         @default("{}")
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stageRun StageRun         @relation(fields: [stageRunId], references: [id], onDelete: Cascade)
  errors   MigrationError[]

  @@index([stageRunId])
  @@map("object_run")
}

/// Per-project NPSP -> NPC mapping, auto-drafted at Analyze and editable thereafter.
/// `object` is the SOURCE object; `target` is the NPC target object. `options` holds
/// the non-scalar mapping bits { lookups, constants, reconcile } (function-valued
/// `filter`s aren't serialized — a named-filter registry is the future path).
/// `enabled` gates whether the pipeline runs this mapping (curated seeds default on;
/// heuristic drafts default off, review-required). See docs/08-transformation-engine.md.
model MappingDefinition {
  id          String    @id @default(uuid())
  projectId   String
  object      String // SOURCE object api name
  target      String? // NPC target object api name (null when unmapped/needs review)
  fieldMap    Json      @default("{}")
  valueMap    Json      @default("{}")
  options     Json      @default("{}") // { lookups?, constants?, reconcile? }
  enabled     Boolean   @default(true)
  autoDrafted Boolean   @default(false)
  confidence  String? // "curated" | "heuristic" | "unmapped"
  version     Int       @default(1)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, object, version])
  @@index([projectId, enabled])
  @@map("mapping_definition")
}

/// Raw extracted source records (Stage 2 output).
model StagingSource {
  id           BigInt   @id @default(autoincrement())
  projectId    String
  object       String
  sourceId     String
  raw          Json
  extractRunId String?
  createdAt    DateTime @default(now())

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, object])
  @@index([projectId, sourceId])
  @@map("staging_source")
}

/// Transformed, NPC-shaped records ready to load (Stage 3 output).
model StagingTarget {
  id           BigInt     @id @default(autoincrement())
  projectId    String
  targetObject String
  sourceObject String
  transformed  Json
  sourceRef    String
  loadStatus   LoadStatus @default(pending)
  targetId     String?
  error        String?
  createdAt    DateTime   @default(now())

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, targetObject])
  @@index([projectId, sourceObject])
  @@index([projectId, loadStatus])
  @@map("staging_target")
}

/// The central ID cross-reference: source IDs -> new target IDs.
model IdXref {
  id           BigInt   @id @default(autoincrement())
  projectId    String
  sourceObject String
  sourceId     String
  targetObject String?
  targetId     String?
  legacyExtId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceId])
  @@index([projectId, sourceObject, sourceId])
  @@map("id_xref")
}

/// Every per-record failure, retryable or not.
model MigrationError {
  id          BigInt   @id @default(autoincrement())
  projectId   String
  objectRunId String?
  stage       String
  object      String
  sourceId    String?
  message     String
  payload     Json     @default("{}")
  retryable   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project   MigrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectRun ObjectRun?       @relation(fields: [objectRunId], references: [id], onDelete: SetNull)

  @@index([projectId, object])
  @@index([projectId, retryable])
  @@map("migration_error")
}
